# Copia questo file in .env (NON viene versionato) e compila i valori.
# Non scrivere mai qui le password di Azure o del cliente.

# --- Database locale (docker compose) ---
POSTGRES_DB=arcade
POSTGRES_USER=postgres
# Scegli una password qualsiasi: serve solo al database locale sul tuo computer.
POSTGRES_PASSWORD=
DB_PORT=5432
# Versione di PostgreSQL: stessa versione maggiore del server Azure (es. postgres:16-alpine).
PG_IMAGE=postgres:16-alpine

# --- Copia dei dati dal database Azure (scripts/azure-db.sh) ---
# Compila host, database e utente. La password NON va qui: lo script la chiede
# (oppure esporta PGPASSWORD solo nella tua shell).
SRC_HOST=
SRC_PORT=5432
SRC_DB=
SRC_USER=
SRC_SSLMODE=require
