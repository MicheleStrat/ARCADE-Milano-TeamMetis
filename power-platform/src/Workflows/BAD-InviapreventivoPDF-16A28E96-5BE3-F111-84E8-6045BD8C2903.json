        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "manual": {
          "metadata": {
            "operationMetadataId": "f7e18204-48e0-43e0-99c2-0e3f3b69bc6f"
          },
          "type": "Request",
          "kind": "PowerAppV2",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "text": {
                  "title": "NumeroPreventivo",
                  "type": "string",
                  "x-ms-dynamically-added": true,
                  "description": "Immettere l'input",
                  "x-ms-content-hint": "TEXT"
                }
              },
              "required": [
                "text"
              ]
            }
          }
        }
      },
      "actions": {
        "Inizializza_variabile": {
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "c53a78e2-98ae-425b-91aa-24bc901f0b14"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "IndirizzoProva",
                "type": "string",
                "value": "nazzarofabrizio@yahoo.it"
              }
            ]
          }
        },
        "LeggiPreventivo": {
          "runAfter": {
            "Inizializza_variabile": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "8865e143-83df-41e8-b6d7-0cee8d778ae4"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_postgresql",
              "operationId": "GetItems",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_postgresql"
            },
            "parameters": {
              "table": "[core].[quote]",
              "$filter": "quote_number eq '@{triggerBody()['text']}'",
              "$top": 1
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "LeggiRighe": {
          "runAfter": {
            "LeggiPreventivo": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "79d3a119-3342-4b98-b8b4-7275b352c42e"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_postgresql",
              "operationId": "GetItems",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_postgresql"
            },
            "parameters": {
              "table": "[core].[quote_line]",
              "$filter": "quote_id eq @{first(body('LeggiPreventivo')?['value'])?['quote_id']}",
              "$orderby": "line_no"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "LeggiEspositore": {
          "runAfter": {
            "LeggiRighe": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "f050efdc-3be9-43ae-b92f-26faf31e803c"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_postgresql",
              "operationId": "GetItems",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_postgresql"
            },
            "parameters": {
              "table": "[core].[exhibitor]",
              "$filter": "\texhibitor_id eq @{first(body('LeggiPreventivo')?['value'])?['exhibitor_id']}",
              "$top": 1
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "LeggiReferente": {
          "runAfter": {
            "LeggiEspositore": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "5ec40ff0-bcef-4bf8-8dfb-7c8fcd1fd25e"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_postgresql",
              "operationId": "GetItems",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_postgresql"
            },
            "parameters": {
              "table": "[core].[exhibitor_contact]",
              "$filter": "exhibitor_id eq @{first(body('LeggiPreventivo')?['value'])?['exhibitor_id']} and is_primary eq true",
              "$top": 1
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Respond_to_a_Power_App_or_flow": {
          "runAfter": {
            "Elimina_file": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "03f93303-1df5-4319-ad71-1166d01751eb"
          },
          "type": "Response",
          "kind": "PowerApp",
          "inputs": {
            "statusCode": 200,
            "body": {
              "esito": "ok"
            },
            "schema": {
              "type": "object",
              "properties": {
                "esito": {
                  "title": "esito",
                  "x-ms-dynamically-added": true,
                  "type": "string"
                }
              }
            }
          }
        },
        "LeggiEdizione": {
          "runAfter": {
            "LeggiReferente": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "d962d9f9-a24d-408c-b5ef-e45387ee9cb4"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_postgresql",
              "operationId": "GetItems",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_postgresql"
            },
            "parameters": {
              "table": "[core].[edition]",
              "$filter": "edition_id eq @{first(body('LeggiPreventivo')?['value'])?['edition_id']}",
              "$top": 1
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "SelezionaRighe": {
          "runAfter": {
            "LeggiEdizione": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "065373df-9875-484e-9472-8ceb5b490047"
          },
          "type": "Select",
          "inputs": {
            "from": "@body('LeggiRighe')?['value']",
            "select": "@concat('<tr><td>', item()?['line_no'], '</td><td>', item()?['description'], '</td><td class=\"n\">', formatNumber(item()?['quantity'], '#,##0.##', 'it-IT'), '</td><td class=\"n\">', formatNumber(item()?['unit_price'], '#,##0.00', 'it-IT'), '</td><td class=\"n\">', formatNumber(item()?['amount'], '#,##0.00', 'it-IT'), '</td></tr>')"
          }
        },
        "RigheHtml": {
          "runAfter": {
            "SelezionaRighe": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "da54db73-6115-431c-96f9-11fb8af3a65f"
          },
          "type": "Compose",
          "inputs": "@join(body('SelezionaRighe'), '')"
        },
        "DocumentoHtml": {
          "runAfter": {
            "LogoBase64": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "43fdcfaf-ebee-45b3-9460-8a0227b40940"
          },
          "type": "Compose",
          "inputs": "<html><head><meta charset=\"utf-8\"><style>\nbody{font-family:'Segoe UI',Arial,sans-serif;font-size:10.5pt;color:#1B2033;margin:0}\ntable{border-collapse:collapse}\n.banda td{background:#4F46E5;color:#FFFFFF;padding:18px 22px}\n.titolo{font-size:18pt;font-weight:bold;margin:0}\n.sottotitolo{font-size:9.5pt;color:#C7D2FE}\n.etdoc{font-size:9pt;color:#C7D2FE;letter-spacing:2px}\n.numdoc{font-size:18pt;font-weight:bold}\n.meta td{background:#EEF1F7;padding:10px 14px}\n.et{font-size:8pt;color:#5A6275;letter-spacing:1px}\n.val{font-size:11pt;font-weight:bold;color:#1B2033}\n.cliente{border-left:4px solid #4F46E5;background:#FFFFFF;padding:10px 16px;border-top:1px solid #D9DEE8;border-right:1px solid #D9DEE8;border-bottom:1px solid #D9DEE8}\n.nome{font-size:13pt;font-weight:bold}\n.sec{font-size:9.5pt;color:#5A6275}\ntable.voci{width:100%}\ntable.voci th{background:#EEF1F7;color:#5A6275;font-size:8pt;letter-spacing:1px;text-align:left;padding:8px;border-bottom:2px solid #4F46E5}\ntable.voci td{padding:9px 8px;border-bottom:1px solid #D9DEE8}\ntable.voci th.n,.n{text-align:right}\ntable.tot td{padding:6px 12px}\ntr.netto td{background:#4F46E5;color:#FFFFFF;font-weight:bold;font-size:12pt}\n.note{font-size:8.5pt;color:#5A6275;background:#EEF1F7;padding:10px 14px}\ntd.f{border-top:1px solid #5A6275;padding-top:4px;font-size:8.5pt;color:#5A6275;width:45%}\n.piede{font-size:7.5pt;color:#5A6275;text-align:center}\n</style></head><body>\n<table width=\"100%\" class=\"banda\"><tr>\n<td width=\"64\"><img src=\"data:image/png;base64,@{outputs('LogoBase64')}\" width=\"56\" height=\"56\"></td>\n<td><div class=\"titolo\">@{first(body('LeggiEdizione')?['value'])?['name']}</div><div class=\"sottotitolo\">Ufficio commerciale</div></td>\n<td class=\"n\"><div class=\"etdoc\">PREVENTIVO</div><div class=\"numdoc\">@{first(body('LeggiPreventivo')?['value'])?['quote_number']}</div></td>\n</tr></table>\n<br>\n<table width=\"100%\" class=\"meta\"><tr>\n<td width=\"32%\"><div class=\"et\">DATA EMISSIONE</div><div class=\"val\">@{convertFromUtc(utcNow(), 'W. Europe Standard Time', 'dd/MM/yyyy')}</div></td>\n<td width=\"2%\" style=\"background:#FFFFFF\"></td>\n<td width=\"32%\"><div class=\"et\">VALIDO FINO AL</div><div class=\"val\">@{formatDateTime(first(body('LeggiPreventivo')?['value'])?['valid_until'], 'dd/MM/yyyy')}</div></td>\n<td width=\"2%\" style=\"background:#FFFFFF\"></td>\n<td width=\"32%\"><div class=\"et\">CODICE ESPOSITORE</div><div class=\"val\">@{first(body('LeggiEspositore')?['value'])?['exhibitor_code']}</div></td>\n</tr></table>\n<br>\n<div class=\"et\">SPETTABILE</div>\n<div class=\"cliente\"><div class=\"nome\">@{first(body('LeggiEspositore')?['value'])?['legal_name']}</div><div class=\"sec\">P. IVA @{first(body('LeggiEspositore')?['value'])?['vat_number']} · @{first(body('LeggiEspositore')?['value'])?['city']}</div><div class=\"sec\">Alla c.a. di @{coalesce(first(body('LeggiReferente')?['value'])?['full_name'], '—')}</div></div>\n<br>\n<table class=\"voci\"><tr><th width=\"30\">N.</th><th>DESCRIZIONE</th><th class=\"n\" width=\"70\">QUANTITÀ</th><th class=\"n\" width=\"110\">PREZZO UNIT. €</th><th class=\"n\" width=\"100\">IMPORTO €</th></tr>\n@{outputs('RigheHtml')}\n</table>\n<table width=\"100%\"><tr><td></td><td width=\"300\">\n<table class=\"tot\" width=\"100%\">\n<tr><td>Totale listino</td><td class=\"n\">@{formatNumber(first(body('LeggiPreventivo')?['value'])?['list_amount'], '#,##0.00', 'it-IT')} €</td></tr>\n@{if(greater(first(body('LeggiPreventivo')?['value'])?['discount_pct'], 0), concat('<tr><td>Sconto ', formatNumber(mul(first(body('LeggiPreventivo')?['value'])?['discount_pct'], 100), '0.##', 'it-IT'), ' %</td><td class=\"n\">- ', formatNumber(sub(first(body('LeggiPreventivo')?['value'])?['list_amount'], first(body('LeggiPreventivo')?['value'])?['net_amount']), '#,##0.00', 'it-IT'), ' €</td></tr>'), '')}\n<tr class=\"netto\"><td>Totale netto</td><td class=\"n\">@{formatNumber(first(body('LeggiPreventivo')?['value'])?['net_amount'], '#,##0.00', 'it-IT')} €</td></tr>\n</table></td></tr></table>\n<br>\n<div class=\"note\">Importi in euro, IVA esclusa. L'offerta è valida fino al @{formatDateTime(first(body('LeggiPreventivo')?['value'])?['valid_until'], 'dd/MM/yyyy')}; fino a quella data gli spazi indicati restano riservati. Per accettare l'offerta restituire questo documento timbrato e firmato.</div>\n<table width=\"100%\" style=\"margin-top:70px\"><tr><td class=\"f\">Luogo e data</td><td width=\"10%\"></td><td class=\"f\">Per accettazione: timbro e firma del legale rappresentante</td></tr></table>\n<br><br>\n<div class=\"piede\">@{first(body('LeggiEdizione')?['value'])?['name']} · documento generato dal back-office ARCADE</div>\n</body></html>"
        },
        "CreaHtml": {
          "runAfter": {
            "DocumentoHtml": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "9b01054d-d9a1-4fc4-92df-cc435c187fcc"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_onedriveforbusiness",
              "operationId": "CreateFile",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_onedriveforbusiness"
            },
            "parameters": {
              "folderPath": "/ArcadePreventivi",
              "name": "@{first(body('LeggiPreventivo')?['value'])?['quote_number']}.html",
              "body": "@outputs('DocumentoHtml')"
            },
            "authentication": "@parameters('$authentication')"
          },
          "runtimeConfiguration": {
            "contentTransfer": {
              "transferMode": "Chunked"
            }
          }
        },
        "ConvertiPdf": {
          "runAfter": {
            "CreaHtml": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "ec03bb81-16f4-4f6d-af27-c24a0423bd23"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_onedriveforbusiness",
              "operationId": "ConvertFile",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_onedriveforbusiness"
            },
            "parameters": {
              "id": "@outputs('CreaHtml')?['body/Id']",
              "type": "PDF"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "InviaMail": {
          "runAfter": {
            "ConvertiPdf": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "2907331f-db2b-41d4-82e5-55fa80a3c92e"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_office365",
              "operationId": "SendEmailV2",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
            },
            "parameters": {
              "emailMessage/To": "@variables('IndirizzoProva')",
              "emailMessage/Subject": "Preventivo @{first(body('LeggiPreventivo')?['value'])?['quote_number']} - @{first(body('LeggiEdizione')?['value'])?['name']}",
              "emailMessage/Body": "<p>[PROVA] In produzione questa mail andrebbe a: @{coalesce(first(body('LeggiReferente')?['value'])?['email'], 'nessun referente principale')}<br>\nGentile @{coalesce(first(body('LeggiReferente')?['value'])?['full_name'], 'Cliente')},<br>\n<br>\nin allegato il preventivo @{first(body('LeggiPreventivo')?['value'])?['quote_number']} per la partecipazione a @{first(body('LeggiEdizione')?['value'])?['name']}, valido fino al @{formatDateTime(first(body('LeggiPreventivo')?['value'])?['valid_until'], 'dd/MM/yyyy')}.<br>\n<br>\nPer confermare, rispondete a questa mail allegando il documento timbrato e firmato.<br>\n<br>\nCordiali saluti<br>\nUfficio commerciale ARCADE Milano</p>",
              "emailMessage/Attachments": [
                {
                  "Name": "@{first(body('LeggiPreventivo')?['value'])?['quote_number']}.pdf",
                  "ContentBytes": "@body('ConvertiPdf')"
                }
              ],
              "emailMessage/Importance": "Normal"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Elimina_file": {
          "runAfter": {
            "InviaMail": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "7eeb1e69-e882-4536-9190-fc00ee941be7"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_onedriveforbusiness",
              "operationId": "DeleteFile",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_onedriveforbusiness"
            },
            "parameters": {
              "id": "@outputs('CreaHtml')?['body/Id']"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "LogoBase64": {
          "runAfter": {
            "RigheHtml": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "dc3d47bc-6700-433a-8965-4e45b0f69b33"
          },
          "type": "Compose",
          "inputs": ""
        }
      }
    },
    "templateName": ""
  },
  "schemaVersion": "1.0.0.0"
}