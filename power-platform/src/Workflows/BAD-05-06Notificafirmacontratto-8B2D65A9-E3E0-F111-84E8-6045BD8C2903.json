            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Leggi_acconto": {
          "runAfter": {
            "Leggi_espositore": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "bf6dcf4d-99dc-41fa-82f0-b820cc34db0a"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_postgresql",
              "operationId": "GetItems",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_postgresql"
            },
            "parameters": {
              "table": "[core].[payment]",
              "$filter": "contract_id eq @{triggerBody()['number']} and kind eq 'DEPOSIT'",
              "$top": 1
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Leggi_saldo": {
          "runAfter": {
            "Leggi_acconto": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "29220748-07c1-40c1-829a-5f8c300818b2"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_postgresql",
              "operationId": "GetItems",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_postgresql"
            },
            "parameters": {
              "table": "[core].[payment]",
              "$filter": "contract_id eq @{triggerBody()['number']} and kind eq 'BALANCE'",
              "$top": 1
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Corpo_email": {
          "runAfter": {
            "Leggi_saldo": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "e59c6fa4-185a-41b5-96e0-f3604336c1eb"
          },
          "type": "Compose",
          "inputs": "<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#EEF1F7;padding:24px 0;font-family:Segoe UI,Arial,sans-serif\">\n<tr><td align=\"center\">\n<table width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#FFFFFF;border-radius:12px;overflow:hidden;border:1px solid #D9DEE8\">\n<tr><td style=\"background:#4F46E5;padding:20px 24px;color:#FFFFFF\">\n<div style=\"font-size:12px;letter-spacing:2px;color:#C7D2FE\">ARCADE MILANO · UFFICIO COMMERCIALE</div>\n<div style=\"font-size:22px;font-weight:bold;margin-top:4px\">Contratto firmato</div>\n</td></tr>\n<tr><td style=\"padding:20px 24px 8px 24px;color:#1B2033\">\n<div style=\"font-size:12px;color:#5A6275;letter-spacing:1px\">ESPOSITORE</div>\n<div style=\"font-size:18px;font-weight:bold;margin-top:2px\">@{coalesce(body('Leggi_espositore')?['legal_name'], 'n.d.')}</div>\n<div style=\"font-size:13px;color:#5A6275\">Codice @{coalesce(body('Leggi_espositore')?['exhibitor_code'], 'n.d.')}</div>\n</td></tr>\n<tr><td style=\"padding:8px 24px\">\n<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr>\n<td width=\"32%\" style=\"background:#EEF1F7;padding:10px 12px\"><div style=\"font-size:11px;color:#5A6275;letter-spacing:1px\">CONTRATTO</div><div style=\"font-size:15px;font-weight:bold;color:#1B2033\">@{coalesce(body('Leggi_contratto')?['contract_number'], 'n.d.')}</div></td>\n<td width=\"2%\"></td>\n<td width=\"32%\" style=\"background:#EEF1F7;padding:10px 12px\"><div style=\"font-size:11px;color:#5A6275;letter-spacing:1px\">FIRMATO IL</div><div style=\"font-size:15px;font-weight:bold;color:#1B2033\">@{if(empty(body('Leggi_contratto')?['signed_on']), 'n.d.', formatDateTime(coalesce(body('Leggi_contratto')?['signed_on'], '1900-01-01'), 'dd/MM/yyyy'))}</div></td>\n<td width=\"2%\"></td>\n<td width=\"32%\" style=\"background:#4F46E5;padding:10px 12px\"><div style=\"font-size:11px;color:#C7D2FE;letter-spacing:1px\">NETTO (IVA ESCL.)</div><div style=\"font-size:15px;font-weight:bold;color:#FFFFFF\">@{formatNumber(float(coalesce(body('Leggi_contratto')?['net_amount'], 0)), 'N2', 'it-IT')} €</div></td>\n</tr></table>\n</td></tr>\n<tr><td style=\"padding:16px 24px 4px 24px;font-size:12px;font-weight:bold;color:#5A6275;letter-spacing:1px\">PIANO DI PAGAMENTO</td></tr>\n<tr><td style=\"padding:0 24px\">\n<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border:1px solid #EEF1F7;font-size:14px;color:#1B2033\">\n<tr style=\"background:#F8FAFC\"><td style=\"padding:8px 12px;font-size:12px;font-weight:bold;color:#5A6275;border-bottom:2px solid #4F46E5\">Tipo</td><td style=\"padding:8px 12px;font-size:12px;font-weight:bold;color:#5A6275;border-bottom:2px solid #4F46E5\">Scadenza</td><td align=\"right\" style=\"padding:8px 12px;font-size:12px;font-weight:bold;color:#5A6275;border-bottom:2px solid #4F46E5\">Importo</td></tr>\n<tr><td style=\"padding:10px 12px;border-bottom:1px solid #EEF1F7\">Acconto</td><td style=\"padding:10px 12px;border-bottom:1px solid #EEF1F7\">@{if(empty(first(body('Leggi_acconto')?['value'])?['due_on']), 'n.d.', formatDateTime(coalesce(first(body('Leggi_acconto')?['value'])?['due_on'], '1900-01-01'), 'dd/MM/yyyy'))}</td><td align=\"right\" style=\"padding:10px 12px;border-bottom:1px solid #EEF1F7\">@{formatNumber(float(coalesce(first(body('Leggi_acconto')?['value'])?['due_amount'], 0)), 'N2', 'it-IT')} €</td></tr>\n<tr><td style=\"padding:10px 12px\">Saldo</td><td style=\"padding:10px 12px\">@{if(empty(first(body('Leggi_saldo')?['value'])?['due_on']), 'n.d.', formatDateTime(coalesce(first(body('Leggi_saldo')?['value'])?['due_on'], '1900-01-01'), 'dd/MM/yyyy'))}</td><td align=\"right\" style=\"padding:10px 12px\">@{formatNumber(float(coalesce(first(body('Leggi_saldo')?['value'])?['due_amount'], 0)), 'N2', 'it-IT')} €</td></tr>\n</table>\n</td></tr>\n<tr><td style=\"padding:16px 24px 20px 24px;font-size:12px;color:#5A6275\">Importi calcolati alla firma con la regola del listino (acconto 30 %, saldo il resto). Gli incassi si registrano nel back-office, schermata Pagamenti.<br><br>Messaggio automatico del back-office ARCADE.</td></tr>\n</table>\n</td></tr></table>"
        },
        "Invia_notifica": {
          "runAfter": {
            "Corpo_email": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "cce6cd56-359c-4b8f-92da-b5bdbef19d3d"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_office365",
              "operationId": "SendEmailV2",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
            },
            "parameters": {
              "emailMessage/To": "@parameters('Email amministrazione (metis_EmailAmministrazione)')",
              "emailMessage/Subject": "@concat('Contratto firmato ', coalesce(body('Leggi_contratto')?['contract_number'], ''), ' - ', coalesce(body('Leggi_espositore')?['legal_name'], ''))",
              "emailMessage/Body": "<p>@{outputs('Corpo_email')}</p>",
              "emailMessage/Importance": "Normal"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Rispondi_ok": {
          "runAfter": {
            "Invia_notifica": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "a37db782-63d7-445e-92be-b377f95c17d8"
          },
          "type": "Response",
          "kind": "PowerApp",
          "inputs": {
            "statusCode": 200,
            "body": {
              "esito": "ok"
            },
            "schema": {
              "type": "object",
              "properties": {
                "esito": {
                  "title": "esito",
                  "x-ms-dynamically-added": true,
                  "type": "string"
                }
              }
            }
          }
        },
        "Rispondi_errore": {
          "runAfter": {
            "Invia_notifica": [
              "Failed",
              "Skipped",
              "TimedOut"
            ]
          },
          "metadata": {
            "operationMetadataId": "94ce7e20-3d04-4e20-860a-c96f2924be76"
          },
          "type": "Response",
          "kind": "PowerApp",
          "inputs": {
            "statusCode": 200,
            "body": {
              "esito": "errore"
            },
            "schema": {
              "type": "object",
              "properties": {
                "esito": {
                  "title": "esito",
                  "x-ms-dynamically-added": true,
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "templateName": ""
  },
  "schemaVersion": "1.0.0.0"
}