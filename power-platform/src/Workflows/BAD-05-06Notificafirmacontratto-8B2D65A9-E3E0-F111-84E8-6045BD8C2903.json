                  "x-ms-dynamically-added": true,
                  "description": "Id del contratto appena firmato (core.contract.contract_id)",
                  "x-ms-content-hint": "NUMBER"
                }
              },
              "required": [
                "number"
              ]
            }
          }
        }
      },
      "actions": {
        "Leggi_contratto": {
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "c35e9aa5-b671-4169-b0ac-6f9f14645876"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_postgresql",
              "operationId": "GetItem",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_postgresql"
            },
            "parameters": {
              "table": "[core].[contract]",
              "id": "@triggerBody()['number']"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Leggi_espositore": {
          "runAfter": {
            "Leggi_contratto": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "7c7e9f50-1d2e-477c-8496-0355fa645eb7"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_postgresql",
              "operationId": "GetItem",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_postgresql"
            },
            "parameters": {
              "table": "[core].[exhibitor]",
